{
  "name": "pr-sentinel",
  "displayName": "PR Sentinel",
  "description": "Detects potential backend-to-frontend breaking changes in GitHub Pull Requests using TypeScript AST and Gemini.",
  "version": "0.1.0",
  "publisher": "pr-sentinel",
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Linters",
    "Programming Languages",
    "Other"
  ],
  "activationEvents": [],
  "main": "./dist/extension.cjs",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "pr-sentinel",
          "title": "PR Sentinel",
          "icon": "media/shield.svg"
        }
      ]
    },
    "views": {
      "pr-sentinel": [
        {
          "type": "webview",
          "id": "prSentinel.findingsView",
          "name": "PR Sentinel Findings"
        }
      ]
    },
    "commands": [
      {
        "command": "pr-sentinel.analyzePR",
        "title": "PR Sentinel: Analyze & Review Current PR / MR",
        "category": "PR Sentinel"
      },
      {
        "command": "pr-sentinel.linkRepo",
        "title": "PR Sentinel: Link Workspace Repository & Browse Open PRs",
        "category": "PR Sentinel"
      },
      {
        "command": "pr-sentinel.reviewPR",
        "title": "PR Sentinel: Run Senior Staff PR Review",
        "category": "PR Sentinel"
      },
      {
        "command": "pr-sentinel.showFindings",
        "title": "PR Sentinel: Show Blast Radius & Review Findings",
        "category": "PR Sentinel"
      },
      {
        "command": "pr-sentinel.setToken",
        "title": "PR Sentinel: Set Personal Access Token (PAT)",
        "category": "PR Sentinel"
      },
      {
        "command": "pr-sentinel.clearToken",
        "title": "PR Sentinel: Clear Saved Token",
        "category": "PR Sentinel"
      }
    ],
    "configuration": {
      "title": "PR Sentinel",
      "properties": {
        "prSentinel.githubToken": {
          "type": "string",
          "default": "",
          "description": "GitHub Personal Access Token with repo scope for analyzing private repositories."
        },
        "prSentinel.gitlabToken": {
          "type": "string",
          "default": "",
          "description": "GitLab Personal Access Token with read_api and read_repository scopes."
        }
      }
    }
  },
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "compile-extension": "esbuild src/extension/extension.ts --bundle --platform=node --format=cjs --external:vscode --minify --outfile=dist/extension.cjs",
    "build": "vite build && esbuild src/extension/extension.ts --bundle --platform=node --format=cjs --external:vscode --minify --outfile=dist/extension.cjs",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "lucide-react": "^0.546.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^6.2.3",
    "express": "^4.21.2",
    "dotenv": "^17.2.3",
    "motion": "^12.23.24"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@types/vscode": "^1.134.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3"
  }
}
